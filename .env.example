# ============================================================================
#  環境変数のサンプル
#  ローカル: cp .env.example .env  →  docker run --env-file .env ...
#  Railway : 服务 → Variables に同じ内容を貼り付け (PORT は自動注入される)
#
#  ★ .env は .gitignore / .dockerignore 済み。絶対にコミットしないでください。
# ============================================================================

# ---- 必須 -----------------------------------------------------------------
# API トークン。未設定だとアプリは起動を拒否します。
# 生成例: openssl rand -hex 32
AUTH_TOKEN=change-me-to-a-long-random-string

# ---- 保存先 / 容量 ---------------------------------------------------------
# ダウンロードしたファイルの保存先。
#  * 既定の /app/downloads はコンテナ内のエフェメラル領域です。
#  * Railway Volume を使う場合は同じパスにマウントし、
#    さらに RAILWAY_RUN_UID=0 の設定が必要です (Volume は root 所有のため)。
DOWNLOAD_DIR=/app/downloads

# 空き容量がこの値 (MB) を下回ると新規ジョブを 507 で拒否する
MIN_FREE_DISK_MB=200

# 1 ファイルの上限 (MB)。0 で無制限。超過分は破棄してジョブを失敗させる。
MAX_FILESIZE_MB=0

# ---- 実行制御 --------------------------------------------------------------
# 同時ダウンロード数。RAM/CPU/帯域に直結するので最初は 2 が安全。
MAX_CONCURRENT=2

# 未取得ファイルの保持秒数 (クライアントが取りに来なかった場合の保険)
FILE_TTL_SECONDS=600

# 完了/失敗ジョブをメモリ上の履歴から消すまでの秒数
JOB_TTL_SECONDS=3600

# 掃除スレッドの実行間隔 (秒)
REAPER_INTERVAL=20

# どのジョブにも属さない .part などの猶予秒数
TEMP_FILE_GRACE_SECONDS=1800

# メモリ上に保持するジョブ数の上限
MAX_HISTORY=200

# ---- セキュリティ ----------------------------------------------------------
# 許可する URL スキーム (file:// などを必ず除外しておく)
ALLOWED_SCHEMES=http,https

# 1 = localhost / 127.0.0.1 / 169.254.169.254 / 10.x / 192.168.x などを拒否 (SSRF対策)
# ローカル開発で自分のマシン上の HTTP サーバを試すときだけ 0 にする
BLOCK_PRIVATE_HOSTS=1

# 抽出元ホワイトリスト (カンマ区切り / glob可)。空なら全サイト許可。
# 例: youtube のみ許可 → ALLOWED_EXTRACTORS=youtube
# 例: YouTube 系全部  → ALLOWED_EXTRACTORS=youtube*
ALLOWED_EXTRACTORS=

# 1 でプレイリスト一括取得 (完了時に ZIP) を許可
ALLOW_PLAYLIST=0

# 年齢制限・メンバー限定動画を取得する場合の cookies.txt 絶対パス。
# Railway では Volume 上に置くか、シークレットとして配布する必要があります。
# COOKIES_FILE=/app/downloads/cookies.txt

# ---- 音声のみ抽出の設定 ----------------------------------------------------
AUDIO_CODEC=mp3
AUDIO_QUALITY=192

# ---- サイト固有リゾルバ ----------------------------------------------------
# yt-dlp に専用 extractor が無い HLS ホスト (StreamHG / iPlayerHLS など) の
# 「動画ページ URL」を、内部の .m3u8 + Referer へ自動変換する機能。
# 1=有効(既定) / 0=無効 (無効にすると URL はそのまま yt-dlp へ渡されます)
ENABLE_SITE_RESOLVERS=1

# リゾルバの対象ホストを追加する (カンマ区切り)。StreamHG 系はミラードメインが
# 多いため、新しいドメインが出てもコード変更 없이追加できます。
# 例) RESOLVER_EXTRA_HOSTS=streamhg.net,another-mirror.example
RESOLVER_EXTRA_HOSTS=

# ---- ログ ------------------------------------------------------------------
LOG_LEVEL=INFO

# ---- Railway が自動注入するもの (手動設定不要) ------------------------------
# PORT=8080
# RAILWAY_VOLUME_MOUNT_PATH=/app/downloads

# ---- Volume を /app/downloads にマウントする場合のみ追加 --------------------
# (Volume は root 所有でマウントされ、イメージは非 root ユーザで動くため)
# RAILWAY_RUN_UID=0
